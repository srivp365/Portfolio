---
import { Font } from "astro:assets";
import { Image } from 'astro:assets';
import profilepic from '../assets/pfp_.webp';
import { projects } from '../data/projects.js';
const bg = "#0e1011";
const bg_panel = "#141618"; 
const text = "#EDEBE6";
const text_dim = "#94969B";
const text_faint = "#5A5D62";
const accent = "#FF4B12";
const accent_dim = "#a8390f";
const accent_soft = "rgba(255,75,18,0.13)";
const olive = "#848c78";
const radius = "2px";
const disp = "'Barlow Condensed', sans-serif";
const mono = "'JetBrains Mono',monospace";
const body = "'Inter',sans-serif";
const line = "#2B2E31";
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-barlow" preload />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-jetbrains" />
        <title>Sri's Portfolio</title>
    </head>
    <body>
<style define:vars={{ bg, text, text_dim, text_faint, accent, line}}>

      /* --- CORE REVEAL ANIMATIONS --- */
      @keyframes sectionReveal {
        0% { opacity: 0; transform: translateY(15px); }
        100% { opacity: 1; transform: translateY(0); }
      }
      
      @keyframes navReveal {
        0% { opacity: 0; transform: translateY(-10px); }
        100% { opacity: 1; transform: translateY(0); }
      }

      /* general styles */
      body {
        background: var(--bg); 
        margin: 0px;
      }

       ::selection {
          background-color: var(--accent);
          color: #000000;
      }

      .accented_text {
        color: var(--accent);
      }

      section {
        padding: 120px 0;
        border-bottom: 1px solid var(--line);
        position: relative;
        /* Default state for reveal */
        opacity: 0;
        animation: sectionReveal 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      }
      
      /* Staggered entry */
      .hero { animation-delay: 0.1s; }
      .marquee { animation-delay: 0.2s; opacity: 0; animation: sectionReveal 0.6s ease forwards; }
      #work { animation-delay: 0.3s; }
      #info { animation-delay: 0.4s; }
      #contact { animation-delay: 0.5s; }

      .section-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 64px;
        gap: 24px;
        flex-wrap: wrap;
      }

      .section-head h2 {
        color: #EDEBE6;
        line-height: 0.90;
        font-family: var(--font-barlow);
        font-size: clamp(36px, 5vw, 64px);
        text-transform: uppercase;
        font-weight: 800;
        margin: 0;
      }

      .section-num {
        font-family: var(--font-jetbrains);
        font-size: 13px;
        color: var(--text_faint);
        text-align: right;
        text-transform: uppercase;
        letter-spacing: .05em;
      }

      .wrap {
        max-width: 1240px;
        margin: 0 auto;
        padding: 0 32px;
      }

      /* navbar styles */ 

      .navbar {
        background: rgba(11, 12, 13, 0.82);
        backdrop-filter: blur(10px);
        max-width: 1240px;
        margin: 0 auto;
        padding: 16px 32px;
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        flex: 1;
        opacity: 0;
        animation: navReveal 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards 0.3s;
      } 

      nav {
        display: flex;
        flex-direction: row;
        justify-content: center;
        align-items: center;
        gap: 36px;
      } 

      .navbar p,
      .navbar a
      {
        font-size: 14px; 
        color: var(--text_dim);
        font-family: var(--font-jetbrains);
        margin: 0px;
        padding: 0px;
        text-transform: uppercase;
        text-decoration: none;
        position: relative;
        transition: color 0.2s ease;
      }
      
      /* Hover Interaction: Color change */
      .navbar a:hover {
        color: #EDEBE6;
      }
      
      /* Hover Interaction: Underline Spawn */
      .navbar a::after {
        content: '';
        position: absolute;
        width: 100%;
        height: 1px;
        bottom: -4px;
        left: 0;
        background-color: var(--accent);
        transform: scaleX(0);
        transform-origin: bottom center;
        transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      }
      
      .navbar a:hover::after {
        transform: scaleX(1);
      }

      header {
        border-bottom: 1px solid;
        border-color: #2B2E31;
        position: sticky;
        top: 0;
        width: 100%;
        z-index: 100;
      }

      .status .dot {
        display: inline-block;
        margin: 0px 10px;
        width: 6px;
        height: 6px;
        border-radius: 50%; 
        background: #5fd97a; 
        animation: blink 2.4s ease-in-out infinite; 
      }

      .status {
        display: flex;
        flex-direction: row;
        justify-content: center;
        align-items: center;
      }
         
      @keyframes blink {
        0%, 100% { opacity: 1; }
        50% { opacity: .25; }
      }                   

      /* hero segment */

      .hero {
        display: flex;
        flex-direction: column;
        max-width: 1240px;
        margin: 0 auto;
        padding: 16px 48px;
        display: flex;
      }

      .hero > h1 {
        color: #EDEBE6;
        line-height: 0.90;
        font-family: var(--font-barlow);
        font-size: clamp(52px, 11vw, 152px);
        margin-bottom: 15px;
        text-transform: uppercase;
        font-weight: 800;
      }

      .hero > p {
        color: var(--text_dim)
      }
                                          
      .hero-subtext {
        line-height: 1.5;
        font-family: var(--font-inter);
        text-align: justify;
      }  

      .hero-table {
        margin-top: 5px;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        border-top: 1px solid;
        border-color: var(--line);
      }

      .hero-table p {
        font-family: var(--font-jetbrains);

      }

      .hero-table div {
        grid-column: span 1;
        border-right: 1px solid var(--line);
        padding-left: 8px;
        align-items: center;
        align-self: center;
        justify-content: center;
      }

      .hero-table div:last-child {
        border-right: 0px;
      }

      .hero-table-heading {
        font-size: 12px;
        color: var(--text_faint);
        text-transform: uppercase;
      }

      .hero-table-text {
        font-size: 14px;
        color: #EDEBE6;
      }

      @media (max-width: 720px) {
        .wrap {
          padding: 0 20px;
        }
      }


      /* marquee */
  
      .marquee {
        margin-top: 8%;
        border-top: 1px solid var(--line);
        border-bottom: 1px solid var(--line);
        overflow: hidden;
        white-space: nowrap;
        padding: 14px 0;
        background: var(--bg-panel);
      }
  
      .marquee-track {
        display: inline-flex;
        gap: 40px;
        animation: marquee 26s linear infinite;
      }
  
      .marquee:hover .marquee-track {
        animation-play-state: paused;
      }
  
      .marquee span {
        font-family: var(--mono);
        font-size: 13px;
        letter-spacing: .1em;
        color: var(--text-dim);
        text-transform: uppercase;
        display: inline-flex;
        align-items: center;
        gap: 40px;
      }
  
      .marquee span em {
        color: var(--accent);
        font-style: normal;
      }
  
      .marquee span {
        color: var(--text_dim);
        font-family: var(--font-jetbrains);
      }
  
      @keyframes marquee {
        from { transform: translateX(0); }
        to { transform: translateX(-50%); }
      }
  
      /* work */
      
      .section-header {
        color: #EDEBE6;
        line-height: 0.90;
        font-family: var(--font-barlow);
        font-size: clamp(18px, 3vw, 102px);
        margin: 3% 0%;
        text-transform: uppercase;
        font-weight: 800;
      }

      /* info */
      
      #info h1 {
        font-family: var(--font-barlow);
        color: var(--text)
      }

      #info p {
        font-family: var(--font-inter);
        color: var(--text_dim);
        line-height: 1.75;
      }

      .info-container {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 80px;
      }

      @media (max-width: 900px) {
        .info-grid {
          grid-template-columns: 1fr; /* Changes it from 2 columns to 1 column */
          gap: 48px; /* Shrinks the gap between the stacked elements */
        }
      }

      /* contact */


      

      .contact-container {
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: flex-end;
        flex-wrap: wrap;
        gap: 40px;
 
      }
       #contact h1 {
        color: #EDEBE6;
        line-height: 0.90;
        font-family: var(--font-barlow);
        font-size: clamp(52px, 6vw, 152px);
        margin-bottom: 15px;
        text-transform: uppercase;
        font-weight: 800;
      }

      .contact-links {
        font-family: var(--font-jetbrains);
        color: var(--text_dim);
        text-decoration: none;
        position: relative;
        transition: color 0.2s ease;
      }
      
      /* Hover Interaction: Color change */
      .contact-links:hover {
        color: #EDEBE6;
      }
      
      /* Hover Interaction: Underline Spawn */
      .contact-links::after {
        content: '';
        position: absolute;
        width: 100%;
        height: 1px;
        bottom: -4px;
        left: 0;
        background-color: var(--accent);
        transform: scaleX(0);
        transform-origin: bottom center;
        transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      }
      
      .contact-links:hover::after {
        transform: scaleX(1);
      }

      /* written by ai */
      .contact-link-container {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 8px; 
      }

      /* footer */
      footer {
        display: flex;
        flex-direction: column;
        max-width: 1240px;
        margin: 0 auto;
        padding: 16px 48px;
        display: flex;
        padding:28px 0;
      }

      /* work cards */
      .work-table {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1px;
        background: var(--line);
        border: 1px solid var(--line);
        margin-top: 12px;
      }
      
      .work-card {
        position: relative;
        background: var(--bg);
        padding: 28px;
        text-decoration: none;
        display: block;
        /* Smooth transitions for button effect */
        transition: background-color 0.25s ease, transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      }
      
      /* Hover Interaction: Button Background Change + Slight Lift */
      .work-card:hover { 
        background: var(--bg_panel, #141618); 
      }
      
      .work-card::before, .work-card::after {
        content: ""; position: absolute; width: 12px; height: 12px;
        border: 1.5px solid var(--accent); opacity: 0; transition: all .15s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .work-card::before { top: -1px; left: -1px; border-right: none; border-bottom: none; }
      .work-card::after { bottom: -1px; right: -1px; border-left: none; border-top: none; }
      
      /* EXISTING Corner frame animation - made smoother */
      .work-card:hover::before, .work-card:hover::after { 
        opacity: 1; 
        transform: scale(1.05); /* Extra subtle pop on corners */
      }
      
      .work-id { font-family: var(--font-jetbrains); font-size: 11px; color: var(--accent); letter-spacing: .1em; }
      
      .work-title { 
        font-family: var(--font-barlow); font-size: 30px; text-transform: uppercase;
        color: var(--text); margin: 8px 0 6px; font-weight: 700;
        transition: color 0.2s ease, transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      }
      
      /* Hover Interaction: Title color change + Shift */
      .work-card:hover .work-title {
        color: #fff;
        transform: translateX(4px);
      }
      
      .work-cat { font-family: var(--font-jetbrains); font-size: 11px; color: var(--text_faint);
        text-transform: uppercase; letter-spacing: .08em; transition: color 0.2s ease; }
      
      .work-card:hover .work-cat {
        color: var(--text_dim);
      }

      @media (max-width: 720px) { .work-table { grid-template-columns: 1fr; } }

      .foot-row {
        display:flex;
        justify-content: space-between;
        font-family: var(--font-jetbrains);
        font-size:11px;
        color:var(--text_faint);
        letter-spacing:.06em;
        flex-wrap:wrap;
        gap:10px;
      }
    </style>
    
    <header> 
      <div class="navbar">
      <span style = {{width: "24px", height: "24px", backgroundColor: "#fff", borderRadius: "8px"}}></span>
      <nav>
          <a href="#work">Work</a>
          <a href="#info">Info</a>
          <a href="#contact">Contact</a>
      </nav>
      <div class="status">
      <span class="dot"></span><p>v2.0.0 latest commit</p>
      </div>
      </div>
    </header>

    <section class="hero">
      <h1>Srivathsan <br> <span class="accented_text"> Prasanna -- </span> <br> Computer Eng.</h1>
      <p class="hero-subtext">I am a simpleton from Canada 🍁, who is interested in things, like tech, <br> productivity and other shenanigans. Hop on over to projects to check out some <br> of my work, or check out the sidebar for my contact links and resume ❤️!</p>
      <div class="hero-table">
        <div>
          <p class="hero-table-heading">ROLE</p> 
          <p class="hero-table-text"> PRODUCT / EMBEDDED SYSTEMS </p>
        </div>
        <div>
          <p class="hero-table-heading">FOCUS</p> 
          <p class="hero-table-text"> AI / HARDWARE </p>
        </div>
        <div>
          <p class="hero-table-heading">BASED</p> 
          <p class="hero-table-text">OAKVILLE / TORONTO, CA</p>
        </div>
        <div>
          <p class="hero-table-heading">AVAIL.</p> 
          <p class="hero-table-text">Q4 2026</p>
        </div>
      </div>
    </section>

    <!-- This marquee doesn't have links, so it doesn't need underlining animation, but it inherits slide-in entry -->
    <div class="marquee">
      <div class="marquee-track">
        <span>REACT <em>//</em> EMBEDDED SYSTEMS <em>//</em> SWIFT <em>//</em> CAD <em>//</em> TYPESCRIPT <em>//</em> PCB DESIGN <em>//</em> SWIFT UI <em>//</em> RUST <em>//</em></span>
        <span>REACT <em>//</em> EMBEDDED SYSTEMS <em>//</em> SWIFT <em>//</em> CAD <em>//</em> TYPESCRIPT <em>//</em> PCB DESIGN <em>//</em> SWIFT UI <em>//</em> RUST <em>//</em></span>
      </div>
    </div>


    <section id="work">
      <div class="wrap">
      <h1 class="section-header">Selected <br> Work</h1>
      <div class="work-table">
        {projects.map((p) => (
          <a class="work-card" href={`/projects/${p.slug}`}>
            <div class="work-id">{p.id} / {p.cat}</div>
            <div class="work-title">{p.title}</div>
            <div class="work-cat">{p.tags.join(" / ")}</div>
          </a>
        ))}
      </div>
        </div>
    </section>

   <section id="info">
      <div class="wrap">
<h1 class="section-header">About <br> me</h1>
      <div class="info-container">
        <p> <span style="color: var(--text);">I'm Sri </span>— a computer engineering background, split between shipping consumer software and building the physical objects that go alongside it. I like problems that touch both sides: an app that's only as good as the sensor feeding it, a device that's only as good as its companion screen. <br> <br> <br>
          Most projects start on a breadboard or in a sketchbook before they ever reach a design tool. I try to keep that order — the constraints of the real material should shape the interface, not the other way around. <br> <br> <br>
          Outside of client and personal work, I'm usually taking something apart to see how it's held together
        </p>
        <Image src={profilepic} alt="A bird sitting on a nest of eggs." width="420" height="420" style={{borderRadius: "16px", marginBottom: "18%"}}/>
      </div>
        </div>
    </section>


    <section id="contact">
      <div class="wrap">
      <div class="contact-container">
      <div>
       <h1>Let's build <br> something cool <br> together!</h1>
        <a class="accented_text contact-links" style="font-family: var(--font-jetbrains)" href="mailto:srivprasanna@gmail.com">
         srivprasanna@gmail.com
         <!-- AI made the svg -->
         <svg width="14" height="14" viewBox="0 0 24 24" style="transition: transform 0.2s ease;">
           <path d="M5 19L19 5M19 5H8M19 5V16" stroke="currentColor" stroke-width="2" fill="none"/>
         </svg>
       </a>
      </div>
      <div class="contact-link-container"> 
        <a class= "contact-links" href="https://github.com/srivp365">
          Github
          <!-- AI made the svg -->
         <svg width="14" height="14" viewBox="0 0 24 24" style="transition: transform 0.2s ease;">
           <path d="M5 19L19 5M19 5H8M19 5V16" stroke="currentColor" stroke-width="2" fill="none"/>
         </svg>
        </a> 
        <a class= "contact-links" href="https://www.linkedin.com/in/srivp/">
          Linkedin 
          <!-- AI made the svg -->
         <svg width="14" height="14" viewBox="0 0 24 24" style="transition: transform 0.2s ease;">
           <path d="M5 19L19 5M19 5H8M19 5V16" stroke="currentColor" stroke-width="2" fill="none"/>
         </svg>
        </a> 
        <a class= "contact-links" href="/resume">
          Resume 
          <!-- AI made the svg -->
         <svg width="14" height="14" viewBox="0 0 24 24" style="transition: transform 0.2s ease;">
           <path d="M5 19L19 5M19 5H8M19 5V16" stroke="currentColor" stroke-width="2" fill="none"/>
         </svg>
        </a> 
      </div>
      </div>
      </div>
    </section>


    <footer>
      <div class="foot-row">
        <span>© 2026 SRIVATHSAN PRASANNA — ALL RIGHTS RESERVED</span>
        <span>BUILT IN TORONTO — REVISED: 2026.08.26</span>
      </div>
    </footer>

    
    </body>
</html>
