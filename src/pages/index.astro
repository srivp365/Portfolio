---
import { Font } from "astro:assets";
const bg = "#0e1011";
const bg_panel = "#141618"; 
const text = "#EDEBE6";
const text_dim = "#94969B";
const text_faint = "#5A5D62";
const accent = "#FF4B12";
const accent_dim = "#a8390f";
const accent_soft = "rgba(255,75,18,0.13)";
const olive = "#848c78";
const radius = "2px";
const disp = "'Barlow Condensed', sans-serif";
const mono = "'JetBrains Mono',monospace";
const body = "'Inter',sans-serif";
const line = "#2B2E31";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-barlow" preload />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-jetbrains" />
		<title>Sri's Portfolio</title>
	</head>
	<body>
<style define:vars={{ bg, text, text_dim, text_faint, accent, line}}>

      /* general styles */

      body {
        background: var(--bg); 
        margin: 0px;
      }

       ::selection {
          background-color: var(--accent);
          color: #000000;
      }

      .accented_text {
        color: var(--accent);
      }
      /* navbar styles */ 

      .navbar {
        max-width: 1240px;
        margin: 0 auto;
        padding: 16px 32px;
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        flex: 1;
      } 

      nav {
        display: flex;
        flex-direction: row;
        justify-content: center;
        align-items: center;
        gap: 36px;
      } 

      .navbar p {
        font-size: 14px; 
        color: var(--text_dim);
        font-family: var(--font-jetbrains);
        margin: 0px;
        text-transform: uppercase;
      }

      header {
        border-bottom: 1px solid;
        border-color: #2B2E31;
        position: sticky;
        top: 0;
        width: 100%;
        z-index: 100;
      }

      .status .dot {
        display: inline-block;
        margin: 0px 10px;
        width: 6px;
        height: 6px;
        border-radius: 50%; 
        background: #5fd97a; 
        animation: blink 2.4s ease-in-out infinite; 
      }

      .status {
        display: flex;
        flex-direction: row;
        justify-content: center;
        align-items: center;
      }
         
      @keyframes blink {
        0%, 100% { opacity: 1; }
        50% { opacity: .25; }
      }                   

      /* hero segment */

      .hero {
        display: flex;
        flex-direction: column;
        max-width: 1240px;
        margin: 0 auto;
        padding: 16px 48px;
        display: flex;
      }

      .hero > h1 {
        color: #EDEBE6;
        line-height: 0.90;
        font-family: var(--font-barlow);
        font-size: clamp(52px, 11vw, 152px);
        margin-bottom: 15px;
        text-transform: uppercase;
        font-weight: 800;
      }

      .hero > p {
        color: var(--text_dim)
      }
                                          
      .hero-subtext {
        line-height: 1.5;
        font-family: var(--font-inter);
        text-align: justify;
      }  

      .hero-table {
        margin-top: 5px;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        border-top: 1px solid;
        border-color: var(--line);
      }

      .hero-table p {
        font-family: var(--font-jetbrains);

      }

      .hero-table div {
        grid-column: span 1;
        border-right: 1px solid var(--line);
        padding-left: 8px;
        align-items: center;
        align-self: center;
        justify-content: center;
      }

      .hero-table div:last-child {
        border-right: 0px;
      }

      .hero-table-heading {
        font-size: 12px;
        color: var(--text_faint);
        text-transform: uppercase;
      }

      .hero-table-text {
        font-size: 14px;
        color: #EDEBE6;
      }

      @media (max-width: 720px) {
        .wrap {
          padding: 0 20px;
        }
      }


    /* marquee */

    .marquee {
      margin-top: 8%;
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
      overflow: hidden;
      white-space: nowrap;
      padding: 14px 0;
      background: var(--bg-panel);
    }

    .marquee-track {
      display: inline-flex;
      gap: 40px;
      animation: marquee 26s linear infinite;
    }

    .marquee:hover .marquee-track {
      animation-play-state: paused;
    }

    .marquee span {
      font-family: var(--mono);
      font-size: 13px;
      letter-spacing: .1em;
      color: var(--text-dim);
      text-transform: uppercase;
      display: inline-flex;
      align-items: center;
      gap: 40px;
    }

    .marquee span em {
      color: var(--accent);
      font-style: normal;
    }

    .marquee span {
      color: var(--text_dim);
      font-family: var(--font-jetbrains);
    }

    @keyframes marquee {
      from { transform: translateX(0); }
      to { transform: translateX(-50%); }
    }

    </style>
    

    <header> 
      <div class="navbar">
      <span style = {{width: "24px", height: "24px", backgroundColor: "#fff", borderRadius: "8px"}}></span>
      <nav>
          <p> Work </p>
          <p> Log </p>
          <p> Info </p>
          <p> Contact </p>
      </nav>
      <status class="status">
      <span class="dot"></span><p>v2.0.0 latest commit</p>
      </status>
      </div>
    </header>

    <section class="hero">
      <h1>Srivathsan <br> <span class="accented_text"> Prasanna -- </span> <br> Computer Eng.</h1>
      <p class="hero-subtext">I am a simpleton from Canada 🍁, who is interested in things, like tech, <br> productivity and other shenanigans. Hop on over to projects to check out some <br> of my work, or check out the sidebar for my contact links and resume ❤️!</p>
      <div class="hero-table">
        <div>
          <p class="hero-table-heading">ROLE</p> 
          <p class="hero-table-text"> PRODUCT / EMBEDDED SYSTEMS </p>
        </div>
        <div>
          <p class="hero-table-heading">FOCUS</p> 
          <p class="hero-table-text"> AI / HARDWARE </p>
        </div>
        <div>
          <p class="hero-table-heading">BASED</p> 
          <p class="hero-table-text">OAKVILLE / TORONTO, CA</p>
        </div>
        <div>
          <p class="hero-table-heading">AVAIL.</p> 
          <p class="hero-table-text">Q4 2026</p>
        </div>
      </div>
    </section>

    <!-- This was provided by AI -->
    <div class="marquee">
      <div class="marquee-track">
        <span>REACT <em>//</em> EMBEDDED SYSTEMS <em>//</em> SWIFT <em>//</em> CAD <em>//</em> TYPESCRIPT <em>//</em> PCB DESIGN <em>//</em> SWIFT UI <em>//</em> RUST <em>//</em></span>
        <span>REACT <em>//</em> EMBEDDED SYSTEMS <em>//</em> SWIFT <em>//</em> CAD <em>//</em> TYPESCRIPT <em>//</em> PCB DESIGN <em>//</em> SWIFT UI <em>//</em> RUST <em>//</em></span>
      </div>
    </div>


              





	</body>
</html>
